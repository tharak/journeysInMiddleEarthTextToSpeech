# ---------------------------------------------------------------------------
# Game content and derivatives — NEVER commit these.
#
# The Asmodee Digital Terms (§5.3/§5.4) forbid extracting the content, and the text
# is a protected work (FFG + Middle-earth Enterprises). The generated audio is a
# derivative work. This repository publishes AN EXTRACTOR AND A RENDERER — each
# person runs the extraction against their own installation of the game.
# ---------------------------------------------------------------------------

# extracted corpus (game text, in any format)
corpus/
*.csv

# renderer manifest: it stores "text" and "norm" for every block, which means
# it is the whole corpus under another name. The briefing's .gitignore missed it.
manifest.json
manifest*.json

# everything generated lives here — audio, manifests, fixtures, measurements
output/

# rendered audio, any format, anywhere
audio/
audio_piper/
entrega/

# legacy/jime_extract.py dumps the game's TextAssets here — its own help says
# `-o out/`, and nothing above covers that name. It is the extractor whose whole
# output is the thing this file exists to keep out.
out/
validacao_clone/
*.opus
*.mp3
*.wav
*.flac
*.m4a
*.aac
*.ogg
*.caf

# one audio folder per campaign, at the root (render output)
/bonesofarnor/
/embercrown/
/shadowedpaths/
/spreadingwar/
/hauntingofdale/
/poisonpromise/
/main/

# raw game assets
Data/
*.dat
*.bundle

# `jime play --save-crops DIR` keeps pictures of the game's own screens so the
# OCR can be measured against them. A picture of the text is the text.
crops/
*.npy

# ---------------------------------------------------------------------------
# Voice reference
# ---------------------------------------------------------------------------
# REF_paginasrecolhidas.wav comes from LibriVox (public domain), so distributing
# it would be legally possible. It stays ignored by default to keep the repository
# free of binaries; to commit it, uncomment the line below.
# !ref/REF_paginasrecolhidas.wav

# ---------------------------------------------------------------------------
# Python / macOS
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.tools/
:memory:.ses
*.egg-info/
.pytest_cache/
.ruff_cache/

.DS_Store
._*
.Spotlight-V100
.Trashes

# ---------------------------------------------------------------------------
# Local work
# ---------------------------------------------------------------------------
bench_results.json
*.log
.tmp_*

# Piper voice models — 60 MB each, fetched from huggingface.co/rhasspy/piper-voices
voices/
*.onnx
*.onnx.json
